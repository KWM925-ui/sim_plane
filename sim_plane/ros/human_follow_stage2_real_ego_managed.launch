<launch>
  <arg name="intrinsics_yaml" default="$(find human_follow_fusion)/config/camera_intrinsics.example.yaml" />
  <arg name="extrinsics_yaml" default="$(find human_follow_fusion)/config/camera_mid360_extrinsics.example.yaml" />
  <arg name="camera_body_yaml" default="$(find human_follow_fusion)/config/camera_to_body_stage1_sim.yaml" />
  <arg name="bridge_output_topic" default="/follow/stage2/offboard/setpoint" />
  <arg name="motion_mode" default="scripted_standard" />
  <arg name="loop" default="false" />
  <arg name="random_seed" default="13" />
  <arg name="goal_provider" default="baseline" />
  <arg name="goal_node_name" default="stage2_follow_goal_generator" />
  <arg name="external_goal_pkg" default="human_follow_bringup" />
  <arg name="external_goal_type" default="stage2_follow_goal_generator_node.py" />
  <arg name="planner_command_topic" default="/follow/stage2/ego_position_cmd" />
  <arg name="mavros_setpoint_topic" default="/mavros/setpoint_raw/local" />
  <arg name="set_mode_service" default="/mavros/set_mode" />
  <arg name="stage2_gate_mode_request_retry_sec" default="30.0" />
  <arg name="rviz" default="false" />
  <arg name="follow_distance_m" default="3.5" />
  <arg name="goal_lateral_bias_m" default="0.0" />
  <arg name="goal_vertical_bias_m" default="0.0" />
  <arg name="goal_min_shift_m" default="0.08" />
  <arg name="goal_face_target_yaw" default="true" />
  <arg name="goal_search_timeout_sec" default="2.0" />
  <arg name="goal_lost_timeout_sec" default="5.0" />
  <arg name="goal_search_yaw_rate_rps" default="0.25" />
  <arg name="goal_search_sweep_span_deg" default="0.0" />
  <arg name="goal_search_sweep_pass_count" default="0" />
  <arg name="goal_search_return_to_center" default="false" />
  <arg name="goal_search_radius_m" default="1.0" />

  <rosparam command="load" file="$(find human_follow_perception)/config/perception.yaml" />
  <rosparam command="load" file="$(find human_follow_fusion)/config/fusion.yaml" />
  <rosparam command="load" file="$(find human_follow_px4_bridge)/config/px4_bridge.yaml" />
  <param name="/stage2_offboard_gate/mode_request_retry_sec" value="$(arg stage2_gate_mode_request_retry_sec)" />

  <param name="robot_description" textfile="$(find human_follow_bringup)/urdf/f450_stage1.urdf" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="stage2_robot_state_publisher" output="screen">
    <param name="publish_frequency" value="20.0" />
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="stage2_camera_optical_static_tf" args="0 0 0 -0.5 0.5 0.5 0.5 camera camera_optical_frame" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="stage2_mid360_optical_static_tf" args="0 0 0 -0.5 0.5 0.5 0.5 mid360 mid360_optical_frame" />

  <node pkg="human_follow_bringup" type="human_truth_sequence_publisher_node.py" name="human_truth_sequence_publisher" output="screen">
    <param name="loop" value="$(arg loop)" />
    <param name="motion_mode" value="$(arg motion_mode)" />
    <param name="random_seed" value="$(arg random_seed)" />
  </node>

  <node pkg="human_follow_bringup" type="odom_topic_relay_node.py" name="stage2_mavros_odom_relay" output="screen">
    <param name="input_topic" value="/mavros/local_position/odom" />
    <param name="output_topic" value="/follow/lio/odom" />
    <param name="mirror_topic" value="" />
    <param name="frame_id_override" value="map" />
    <param name="child_frame_id_override" value="base_link" />
    <param name="restamp_now" value="true" />
  </node>

  <node pkg="human_follow_bringup" type="body_truth_world_projector_node.py" name="stage2_body_truth_world_projector" output="screen">
    <param name="input_topic" value="/follow/sim/truth_target_body" />
    <param name="odom_topic" value="/follow/lio/odom" />
    <param name="output_topic" value="/follow/sim/human_truth_world" />
  </node>

  <node pkg="human_follow_fusion" type="truth_driven_scene_publisher_node.py" name="truth_driven_scene_publisher" output="screen">
    <param name="truth_topic" value="/follow/sim/truth_target_body" />
    <param name="phase_topic" value="/follow/sim/truth_phase" />
    <param name="pointcloud_topic" value="/follow/lidar/points" />
    <param name="target_topic" value="/follow/detector/person_target" />
    <param name="debug_target_topic" value="/follow/sim/truth_target_2d" />
    <param name="intrinsics_yaml" value="$(arg intrinsics_yaml)" />
    <param name="extrinsics_yaml" value="$(arg extrinsics_yaml)" />
    <param name="camera_body_yaml" value="$(arg camera_body_yaml)" />
    <param name="phase_visible_affects_tracking" value="true" />
  </node>

  <node pkg="human_follow_fusion" type="truth_follow_visualizer_node.py" name="truth_follow_visualizer" output="screen">
    <param name="intrinsics_yaml" value="$(arg intrinsics_yaml)" />
    <param name="camera_frame_id" value="camera_optical_frame" />
    <param name="camera_mesh_frame_id" value="camera" />
    <param name="lidar_mesh_frame_id" value="mid360" />
  </node>

  <node pkg="human_follow_perception" type="tracker_node.py" name="human_follow_tracker" output="screen" />

  <node pkg="human_follow_fusion" type="target_fusion_node.py" name="human_follow_target_fusion" output="screen">
    <param name="enable_mock_projection" value="false" />
    <param name="pointcloud_topic" value="/follow/lidar/points" />
    <param name="intrinsics_yaml" value="$(arg intrinsics_yaml)" />
    <param name="extrinsics_yaml" value="$(arg extrinsics_yaml)" />
    <param name="output_topic" value="/follow/fusion/target_camera" />
    <param name="output_frame_id" value="camera_optical_frame" />
  </node>

  <node pkg="human_follow_fusion" type="target_frame_adapter_node.py" name="target_frame_adapter" output="screen">
    <param name="input_topic" value="/follow/fusion/target_camera" />
    <param name="output_topic" value="/follow/fusion/target_body" />
    <param name="transform_yaml" value="$(arg camera_body_yaml)" />
  </node>

  <node pkg="human_follow_bringup" type="target_world_projector_node.py" name="target_world_projector" output="screen">
    <param name="input_topic" value="/follow/fusion/target_body" />
    <param name="odom_topic" value="/follow/lio/odom" />
    <param name="output_topic" value="/follow/fusion/target_world" />
  </node>

  <include file="$(find human_follow_bringup)/launch/stage2_real_ego.launch">
    <arg name="stage2_enabled" value="true" />
    <arg name="goal_provider" value="$(arg goal_provider)" />
    <arg name="goal_node_name" value="$(arg goal_node_name)" />
    <arg name="external_goal_pkg" value="$(arg external_goal_pkg)" />
    <arg name="external_goal_type" value="$(arg external_goal_type)" />
    <arg name="goal_topic" value="/follow/stage2/goal" />
    <arg name="debug_goal_path_topic" value="/follow/stage2/debug_goal_path" />
    <arg name="odom_topic" value="/follow/lio/odom" />
    <arg name="target_world_topic" value="/follow/fusion/target_world" />
    <arg name="follow_distance_m" value="$(arg follow_distance_m)" />
    <arg name="goal_lateral_bias_m" value="$(arg goal_lateral_bias_m)" />
    <arg name="goal_vertical_bias_m" value="$(arg goal_vertical_bias_m)" />
    <arg name="goal_min_shift_m" value="$(arg goal_min_shift_m)" />
    <arg name="goal_face_target_yaw" value="$(arg goal_face_target_yaw)" />
    <arg name="goal_search_timeout_sec" value="$(arg goal_search_timeout_sec)" />
    <arg name="goal_lost_timeout_sec" value="$(arg goal_lost_timeout_sec)" />
    <arg name="goal_search_yaw_rate_rps" value="$(arg goal_search_yaw_rate_rps)" />
    <arg name="goal_search_sweep_span_deg" value="$(arg goal_search_sweep_span_deg)" />
    <arg name="goal_search_sweep_pass_count" value="$(arg goal_search_sweep_pass_count)" />
    <arg name="goal_search_return_to_center" value="$(arg goal_search_return_to_center)" />
    <arg name="goal_search_radius_m" value="$(arg goal_search_radius_m)" />
    <arg name="planner_command_topic" value="$(arg planner_command_topic)" />
    <arg name="bridge_output_topic" value="$(arg bridge_output_topic)" />
    <arg name="mavros_setpoint_topic" value="$(arg mavros_setpoint_topic)" />
    <arg name="set_mode_service" value="$(arg set_mode_service)" />
    <arg name="enable_ego_topic_adapter" value="true" />
    <arg name="ego_goal_topic" value="/move_base_simple/goal" />
    <arg name="ego_waypoint_topic" value="/waypoint_generator/waypoints" />
    <arg name="ego_odom_topic" value="/odom_world" />
    <arg name="ego_grid_odom_topic" value="/grid_map/odom" />
    <arg name="ego_cloud_topic" value="/grid_map/cloud" />
  </include>

  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="stage2_real_ego_rviz" args="-d $(find human_follow_bringup)/rviz/stage2_real_ego_integrated.rviz" />
  </group>
</launch>
