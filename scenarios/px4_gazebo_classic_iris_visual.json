{
  "name": "px4_gazebo_classic_iris_visual",
  "description": "Real PX4 plus Gazebo Classic iris quadrotor run with the native Gazebo Classic 3D viewer and local dashboard telemetry.",
  "backend": "px4_gazebo_classic",
  "vehicle": "quadrotor",
  "duration_s": 20.0,
  "update_hz": 5.0,
  "target_altitude_m": 5.0,
  "backend_options": {
    "model": "iris",
    "world": "warehouse",
    "headless": false,
    "mavlink_endpoint": "udpin:127.0.0.1:14540",
    "launch_qgc": false,
    "speed_factor": 1.0,
    "process_start_grace_s": 10.0,
    "shell_command_delay_s": 10.0,
    "shell_command_interval_s": 2.0,
    "shell_commands": [
      "param set MIS_TAKEOFF_ALT 5",
      "commander takeoff"
    ],
    "success_criteria": "takeoff"
  }
}
