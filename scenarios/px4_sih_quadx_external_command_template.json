{
  "name": "px4_sih_quadx_external_command_template",
  "description": "PX4 SIH quadrotor run driven by the repo-local external_command adapter. Replace the command with your own algorithm entrypoint.",
  "backend": "px4_sih",
  "vehicle": "quadrotor",
  "duration_s": 40.0,
  "update_hz": 5.0,
  "target_altitude_m": 4.0,
  "algorithm_adapter": {
    "type": "external_command",
    "command": [
      "python3",
      "examples/user_algorithms/mavsdk_takeoff_template.py"
    ],
    "workdir": "/home/coco/sim_plane",
    "max_runtime_s": 36.0,
    "join_timeout_s": 6.0
  },
  "backend_options": {
    "model": "sihsim_quadx",
    "mavlink_endpoint": "udpin:127.0.0.1:14550",
    "launch_qgc": false,
    "launch_jmavsim": false,
    "success_criteria": "adapter_takeoff"
  }
}
