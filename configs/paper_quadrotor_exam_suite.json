{
  "name": "paper_quadrotor_exam_suite",
  "description": "Standard paper/project-style quadrotor validation exam. This is an algorithm evaluation surface with fixed scenes and KPI names, not a high-fidelity visual-realism benchmark.",
  "base_overrides": {
    "duration_s": 14.0,
    "realtime_factor": 0.0,
    "target_altitude_m": 10.0,
    "safety": {
      "min_altitude_m": 0.0,
      "max_altitude_m": 16.0,
      "max_radius_m": 40.0
    },
    "control_limits": {
      "max_speed_mps": 6.0
    }
  },
  "variants": [
    {
      "name": "hover",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 0.0, "y": 0.0 }
        ]
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_target_reach_time_s": { "max": 5.0 },
        "kpi_altitude_overshoot_m": { "max": 0.01 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "waypoint",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 12.0, "y": 0.0 },
          { "x": 12.0, "y": 8.0 },
          { "x": 0.0, "y": 8.0 },
          { "x": 0.0, "y": 0.0 }
        ]
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_mission_path_error_max_m": { "max": 0.01 },
        "kpi_final_goal_distance_m": { "max": 0.01 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "obstacle_avoidance_proxy",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 5.0, "y": 0.0 },
          { "x": 8.0, "y": 3.0 },
          { "x": 12.0, "y": 0.0 }
        ],
        "safety": {
          "max_radius_m": 20.0
        }
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_safety_violation_count": { "max": 0 },
        "kpi_mission_path_error_max_m": { "max": 0.01 }
      }
    },
    {
      "name": "corridor",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 16.0, "y": 0.0 }
        ],
        "safety": {
          "max_radius_m": 18.0
        }
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_mission_path_error_max_m": { "max": 0.01 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "sensor_dropout",
      "overrides": {
        "degradations": {
          "sensor_dropout": {
            "windows": [
              { "start_s": 6.0, "end_s": 7.0 }
            ]
          }
        }
      },
      "required_metrics": {
        "target_altitude_reached": true,
        "degradation_enabled": true
      },
      "metric_thresholds": {
        "kpi_sensor_dropout_count": { "min": 1 },
        "kpi_target_reacquire_count": { "min": 1 },
        "kpi_sensor_recovery_time_s": { "max": 1.5 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "dynamic_target",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 8.0, "y": 4.0 },
          { "x": 14.0, "y": -3.0 },
          { "x": 20.0, "y": 2.0 }
        ],
        "degradations": {
          "sensor_noise": {
            "position_std_m": 0.06,
            "altitude_std_m": 0.03
          }
        }
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_mission_path_error_max_m": { "max": 0.35 },
        "kpi_measurement_horizontal_error_max_m": { "min": 0.02 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "failure_motor_proxy",
      "overrides": {
        "control_limits": {
          "max_speed_mps": 3.0
        },
        "degradations": {
          "control_saturation": {
            "max_speed_mps": 3.0
          },
          "communication_interruption": {
            "windows": [
              { "start_s": 6.0, "end_s": 6.6 }
            ]
          }
        }
      },
      "required_metrics": {
        "target_altitude_reached": true,
        "degradation_enabled": true
      },
      "metric_thresholds": {
        "control_saturation_count": { "min": 1 },
        "communication_interruption_count": { "min": 1 },
        "kpi_speed_limit_violation_count": { "max": 0 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    },
    {
      "name": "planner_compare",
      "overrides": {
        "waypoints": [
          { "x": 0.0, "y": 0.0 },
          { "x": 6.0, "y": 0.0 },
          { "x": 10.0, "y": 5.0 },
          { "x": 14.0, "y": 0.0 },
          { "x": 0.0, "y": 0.0 }
        ]
      },
      "required_metrics": {
        "target_altitude_reached": true
      },
      "metric_thresholds": {
        "kpi_final_goal_distance_m": { "max": 0.01 },
        "kpi_max_acceleration_mps2": { "max": 20.0 },
        "kpi_safety_violation_count": { "max": 0 }
      }
    }
  ]
}
